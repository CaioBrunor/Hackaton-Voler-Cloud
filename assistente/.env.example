# Copie este arquivo para .env e preencha a chave. O .env NAO vai para o Git.

# Chave da API da Anthropic (crie em https://console.anthropic.com/settings/keys).
# Nunca cole a chave em outro arquivo, no front ou em mensagens de commit.
ANTHROPIC_API_KEY=

# --- Opcionais ---

# Modelo do assistente (padrao: Claude Sonnet 5.5)
ASSISTENTE_MODEL=claude-sonnet-5-5

# Quanto o modelo raciocina: low, medium, high, xhigh ou max (medium e o recomendado)
ASSISTENTE_EFFORT=medium

# Endereco do MCP Server (o mesmo configurado em mcp-server)
MCP_URL=http://127.0.0.1:8000/mcp

# Porta do assistente
ASSISTENTE_PORT=8100

# Enderecos do frontend autorizados a usar o assistente (separados por virgula)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Perguntas por minuto aceitas de cada origem (cada pergunta gasta tokens da API)
ASSISTENTE_LIMITE_POR_MINUTO=20

# Coloque 0 se a sua conta da Anthropic nao tiver o recurso de refazer respostas recusadas em outro modelo
ASSISTENTE_FALLBACK=1
