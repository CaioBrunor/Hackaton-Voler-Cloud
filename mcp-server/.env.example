# Copie este arquivo para .env e ajuste os valores.
# Não coloque senhas ou tokens reais neste arquivo de exemplo.

# Endereço da API REST do backend Spring Boot
BACKEND_URL=http://localhost:8080

# Porta em que o MCP Server escuta (transporte HTTP)
MCP_PORT=8000

# Tempo máximo, em segundos, de espera por uma resposta do backend
API_TIMEOUT=10

# --- Opcionais ---

# Endereço de escuta do MCP. 127.0.0.1 aceita apenas conexões da própria máquina.
MCP_HOST=127.0.0.1

# streamable-http (servidor HTTP) ou stdio (o aplicativo de IA inicia o processo)
MCP_TRANSPORT=streamable-http

# DEBUG, INFO, WARNING ou ERROR. Em DEBUG, cada chamada ao backend também é registrada.
LOG_LEVEL=INFO

# Arquivo de log, além do terminal. Deixe vazio para registrar só no terminal.
LOG_FILE=

# Endereços do frontend que podem chamar o MCP pelo navegador (CORS), separados por vírgula
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
